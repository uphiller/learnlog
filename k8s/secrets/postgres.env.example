# Copy to postgres.env (gitignored). Used for local psql and regenerating SealedSecrets.
#
# Regenerate encrypted manifests after editing:
#   k8s/scripts/seal-secrets.sh
#
# External DB (Supabase, RDS, etc.): set host/user/password from your provider.
# Run schema init once: psql "$DATABASE_URL" -f postgres/init-schemas.sql

POSTGRES_HOST=aws-0-region.pooler.supabase.com
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_USER=postgres.PROJECT_REF
POSTGRES_PASSWORD=

# Optional: full connection URL (psql, GUI clients)
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB

# Used by k8s/scripts/seal-secrets.sh for keycloak-admin SealedSecret
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=

# Service schemas (search_path / currentSchema)
# user-service  -> "user"
# book-service  -> book
# group-service -> "group"
# feedback-service -> feedback
# keycloak      -> keycloak
