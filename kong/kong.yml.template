_format_version: "3.0"
_transform: true

consumers:
  - username: keycloak-board
    jwt_secrets:
      - key: __JWT_ISSUER__
        algorithm: RS256
        rsa_public_key: |
__JWT_RSA_INDENTED__

services:
  - name: django
    url: http://django:8000
    routes:
      - name: health
        paths:
          - /api/health
        strip_path: false
        plugins:
          - name: cors
            config:
              origins:
                - https://log.bettercodelab.com
                - https://board.bettercodelab.com
                - http://localhost:5173
              methods:
                - GET
                - OPTIONS
              headers:
                - Authorization
                - Content-Type
              credentials: true
              max_age: 3600

      - name: api
        paths:
          - /api
        strip_path: false
        plugins:
          - name: cors
            config:
              origins:
                - https://log.bettercodelab.com
                - https://board.bettercodelab.com
                - http://localhost:5173
              methods:
                - GET
                - POST
                - PUT
                - PATCH
                - DELETE
                - OPTIONS
              headers:
                - Authorization
                - Content-Type
              credentials: true
              max_age: 3600
          - name: request-transformer
            config:
              remove:
                headers:
                  - X-User-Sub
                  - X-User-Email
                  - X-User-Name
          - name: jwt
            config:
              uri_param_names: []
              cookie_names: []
              header_names:
                - authorization
              claims_to_verify:
                - exp
              key_claim_name: iss
              secret_is_base64: false
